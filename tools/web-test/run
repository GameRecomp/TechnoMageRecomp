#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Run the browser player in headless Firefox on a game converted for the browser, as a scripted
# run: the log and the frames asked for land in OUT_DIR.
#
#   tools/web-test/run GAME_DIR OUT_DIR "RC_FRAMES=1100&RC_INPUT=…&shots=1090"
#
# GAME_DIR holds game/… and code.wasm (what the page's converter stores). Needs Firefox (with
# JSPI: 139 or later) and the runtime module built:
#   cargo build --release --target wasm32-unknown-unknown -p technomage-web
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
game=${1:?game directory}
out=${2:?output directory}
query=${3:-RC_FRAMES=300}
here=tools/web-test
port=${PORT:-8765}
mkdir -p "$out"
rm -f "$out"/log
profile=$(mktemp -d)
cp "$here/firefox-user.js" "$profile/user.js"
python3 "$here/serve.py" web "$game" "$out" "$port" &
server=$!
trap 'kill $server 2>/dev/null; pkill -f "profile $profile" 2>/dev/null; rm -rf "$profile"' EXIT
sleep 1
timeout "${TIMEOUT:-1800}" firefox --headless --no-remote --profile "$profile" \
    "http://127.0.0.1:$port/t/test.html?$query" >/dev/null 2>&1 &
until [ -f "$out/log" ] && grep -qE '^(exit|returned)|rejection' "$out/log"; do
    sleep 2
    pgrep -f "profile $profile" >/dev/null || break
done
cat "$out/log"
