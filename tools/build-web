#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Assemble the converter site: the page (web/), the converter compiled to
# WebAssembly (rc-web, through wasm-bindgen) and the shell templates.
#
#   tools/build-web SITE_DIR [TEMPLATE_DIR [WEB_SHELL_DIR]]
#
# TEMPLATE_DIR holds TechnoMage-<system>.zip for windows, linux, macos and
# android (made by `recomp template`); those present are copied. The browser player's
# runtime (technomage-web) is built for wasm32 and goes to
# player/technomage.wasm; WEB_SHELL_DIR, if given, is copied over player/ too.
# Systems that platforms.json has off get neither; the file goes to the site
# too, and the page offers them as off.
# Needs the wasm32-unknown-unknown target and wasm-bindgen-cli 0.2.130.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
site=${1:?site directory}
templates=${2:-}
web_shell=${3:-}
cargo build --release --target wasm32-unknown-unknown -p rc-web -p technomage-web ${CARGO_FLAGS:-}
rm -rf "$site"
mkdir -p "$site/templates"
wasm-bindgen --target web --no-typescript --out-dir "$site" \
    "${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/rc_web.wasm"
cp web/index.html web/app.js web/games.js web/worker.js web/style.css \
    web/play.html web/play.js web/player.js web/gl.js "$site/"
cp tools/icons/technomage.svg "$site/"
cp -r web/flags "$site/flags"
version=$(git describe --tags --always --dirty 2>/dev/null || echo dev)
sed -i "s/@VERSION@/$version/" "$site/index.html"
cp platforms.json "$site/platforms.json"
on() { python3 -c 'import json, sys; sys.exit(0 if json.load(open("platforms.json")).get(sys.argv[1], True) else 1)' "$1"; }
if [ -n "$templates" ]; then
    for s in windows linux macos android; do
        if on "$s" && [ -f "$templates/TechnoMage-$s.zip" ]; then
            cp "$templates/TechnoMage-$s.zip" "$site/templates/"
        fi
    done
fi
if on web; then
    mkdir -p "$site/player"
    cp "${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/technomage_web.wasm" \
        "$site/player/technomage.wasm"
    # What player.js takes from the module (games/technomage-web/build.rs links them in).
    if command -v node > /dev/null; then
        node -e '
            const m = new WebAssembly.Module(require("fs").readFileSync(process.argv[1]));
            const have = new Set(WebAssembly.Module.exports(m).map((e) => e.name));
            const missing = ["memory", "__indirect_function_table", "__stack_pointer"].filter((n) => !have.has(n));
            if (missing.length) { console.error(`build-web: the player module does not export ${missing.join(", ")}`); process.exit(1); }
        ' "$site/player/technomage.wasm"
    fi
    if [ -n "$web_shell" ] && [ -d "$web_shell" ]; then
        cp -r "$web_shell"/. "$site/player/"
    fi
fi
echo "build-web: $site ($(du -sh "$site" | cut -f1))"
